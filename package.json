{
  "name": "enric-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "i18n:validate": "etyma validate src/i18n --source es",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios:run": "npx cap run ios",
    "android:run": "npm run build && npx cap sync android && npx cap run android",
    "ios:live": "npx cap run ios --livereload --external",
    "android:live": "npx cap run android --livereload --external",
    "android:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:apk:prod": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@etyma/angular": "^1.0.0",
    "@etyma/core": "^1.0.0",
    "@ionic/angular": "^9.0.12",
    "@tailwindcss/postcss": "^4.3.5",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "ionicons": "^8.1.1",
    "postcss": "^8.5.33",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@etyma/cli": "^1.0.0",
    "@types/file-saver": "^2.0.7",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
